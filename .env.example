
# PostgreSQL 16 configuration
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ticketbooking
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=10

# Application
PORT=3000
NODE_ENV=development

# Authentication
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters

# Booking and checkout
SEAT_HOLD_MINUTES=5
PAYMENT_SIMULATOR_OUTCOME=success

# Database logging
DB_LOGGING=false

# Admin configuration
ADMIN_EMAILS=

# Optional MySQL configuration (only if explicitly switching dialect)
# DB_DIALECT=mysql
# database_name=ticketbooking
# user_name=root
# password=your_mysql_password
# host=localhost
# DB_PORT=3306
