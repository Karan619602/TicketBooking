
# Local development defaults: no MySQL installation required
DB_DIALECT=sqlite
DB_STORAGE=./data/ticketbooking.sqlite

PORT=3000
NODE_ENV=development

# MySQL configuration (only needed when DB_DIALECT=mysql)
database_name=ticketbooking
user_name=root
password=your_mysql_password
host=localhost
DB_PORT=3306

# MySQL-only concurrency integration tests
RUN_DB_TESTS=false
